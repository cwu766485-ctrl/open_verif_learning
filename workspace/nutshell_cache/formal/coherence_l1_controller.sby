[options]
mode bmc
depth 16
multiclock on

[engines]
smtbmc z3

[script]
plugin -i slang
read_slang -D FORMAL CoherenceProtocol.sv MesiL1SnoopArbiter.sv MesiL1Controller.sv coherence_l1_controller_harness.sv
prep -top CoherenceL1ControllerFormal

[files]
rtl/common/CoherenceProtocol.sv
rtl/l1/MesiL1SnoopArbiter.sv
rtl/l1/MesiL1Controller.sv
formal/coherence_l1_controller_harness.sv
