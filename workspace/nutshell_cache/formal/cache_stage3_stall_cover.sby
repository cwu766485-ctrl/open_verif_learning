[options]
mode cover
depth 6

[engines]
smtbmc z3

[script]
read_verilog -formal -DSYNTHESIS CacheStage3.v MetaWriteArbiter.v DataWriteArbiter.v CacheStage3DirectedCoverHarness.v
prep -top CacheStage3StallCoverHarness -flatten

[files]
CacheStage3.v rtl/pipeline/CacheStage3.v
MetaWriteArbiter.v rtl/control/MetaWriteArbiter.v
DataWriteArbiter.v rtl/control/DataWriteArbiter.v
CacheStage3DirectedCoverHarness.v formal/cache_stage3_directed_cover_harness.v
