read_verilog -formal -DSYNTHESIS rtl/legacy_l1/pipeline/CacheStage3.v rtl/legacy_l1/control/MetaWriteArbiter.v rtl/legacy_l1/control/DataWriteArbiter.v formal/cache_stage3_array_harness.v
