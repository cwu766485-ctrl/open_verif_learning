[options]
mode cover
depth 32

[engines]
smtbmc z3

[script]
read_verilog -formal -DSYNTHESIS CacheStage3.v MetaWriteArbiter.v DataWriteArbiter.v CacheStage3MemoryPathCoverHarness.v
prep -top CacheStage3DirtyWritebackCoverHarness -flatten

[files]
CacheStage3.v rtl/legacy_l1/pipeline/CacheStage3.v
MetaWriteArbiter.v rtl/legacy_l1/control/MetaWriteArbiter.v
DataWriteArbiter.v rtl/legacy_l1/control/DataWriteArbiter.v
CacheStage3MemoryPathCoverHarness.v formal/cache_stage3_memory_path_cover_harness.v
