# Keep source, tests, documentation, reports and RTL; ignore local outputs.
*
*.*

!*.py
!*.md
!*.pdf
!Makefile
!Readme.md
!.gitignore
!.gtkwaverc
!pytest.ini
!requirements-dv.txt

# Current Python-based verification environment and regression tests.
!dv/
!dv/**/
!dv/**/*.py
!dv/**/*.md
!dv/**/*.json
!tests/
!tests/**/
!tests/**/*.py
!scripts/
!scripts/*.sh
!formal/
!formal/**/
!formal/*.sby
!formal/*.ys
!formal/*.v
!formal/**/*.sby
!formal/**/*.v
!formal/**/*.py

!src/
!src/**/
!src/**/*.py
!docs/
!docs/*.md
!benchmarks/
!benchmarks/**/
!benchmarks/*.py
!benchmarks/*.md
!benchmarks/results/*.json
!rtl/
!rtl/*.v
!rtl/
!rtl/**/
!rtl/**/*.v
!rtl/*.sv
!rtl/**/*.sv
!rtl/**/*.f
!rtl/**/*.md
!tools/
!tools/*.ps1
!tools/*.json

# Generated Python/simulator state remains ignored even under the exceptions.
src/**/__pycache__/
*.py[cod]
*.fst
*.dat
reports/
Cache/
Cache_modular/
picker_out/

# Keep the final report source and its reproducible build script in Git while
# ignoring generated simulation/formal/coverage artifacts under reports/.
!reports/
reports/*
!reports/final/
reports/final/*
!reports/final/*.md
!reports/final/*.py
!reports/final/*.pdf
