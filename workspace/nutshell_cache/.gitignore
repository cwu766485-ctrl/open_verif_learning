# Keep source, tests, documentation, reports and RTL; ignore local outputs.
*
*.*

!*.py
!*.md
!*.pdf
!Makefile
!Readme.md
!.gitignore
!.gtkwaverc
!pytest.ini
!requirements-dv.txt

# Current Python-based verification environment and regression tests.
!dv/
!dv/**/
!dv/**/*.py
!dv/**/*.md
!dv/**/*.json
!tests/
!tests/**/
!tests/**/*.py

!src/
!src/**/
!src/**/*.py
!test/
!test/**/
!test/*.py
!docs/
!docs/*.md
!report/
!report/*.md
!rtl/
!rtl/*.v
!rtl/
!rtl/**/
!rtl/**/*.v
!rtl/**/*.f
!rtl/**/*.md
!tools/
!tools/*.ps1

# Generated Python/simulator state remains ignored even under the exceptions.
src/**/__pycache__/
test/**/__pycache__/
*.py[cod]
*.fst
*.dat
reports/
report/*.pdf
Cache/
Cache_modular/
picker_out/
