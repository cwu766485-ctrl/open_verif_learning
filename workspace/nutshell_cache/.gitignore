# Keep source, tests, documentation, reports and RTL; ignore local outputs.
*
*.*

!*.py
!*.md
!*.pdf
!Makefile
!Readme.md
!.gitignore
!.gtkwaverc
!pytest.ini

!src/
!src/**/
!src/**/*.py
!test/
!test/**/
!test/*.py
!docs/
!docs/*.md
!report/
!report/*.md
!report/*.pdf
!rtl/
!rtl/*.v
!rtl/modular/
!rtl/modular/*.v
!rtl/modular/*.f
!tools/
!tools/*.ps1

# Generated Python/simulator state remains ignored even under the exceptions.
src/**/__pycache__/
test/**/__pycache__/
*.py[cod]
*.fst
*.dat
reports/
Cache/
Cache_modular/
picker_out/
