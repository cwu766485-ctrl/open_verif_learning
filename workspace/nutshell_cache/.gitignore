# Keep source, tests, documentation, reports and RTL; ignore local outputs.
*
*.*

!*.py
!*.md
!*.pdf
!Makefile
!Readme.md
!.gitignore
!.gtkwaverc
!pytest.ini
!requirements-dv.txt

# Current Python-based verification environment and regression tests.
!dv/
!dv/**/
!dv/**/*.py
!dv/**/*.md
!dv/**/*.json
!dv/**/*.sv
!dv/**/*.svh
!dv/**/*.v
!dv/**/*.f
!tests/
!tests/**/
!tests/**/*.py
!tests/**/*.sv
!tests/**/*.v
!scripts/
!scripts/*.sh
!formal/
!formal/**/
!formal/*.sby
!formal/*.ys
!formal/*.v
!formal/**/*.sby
!formal/**/*.v
!formal/**/*.sv
!formal/**/*.py

!src/
!src/**/
!src/**/*.py
!docs/
!docs/*.md
!docs/releases/
!docs/releases/*.md
!benchmarks/
!benchmarks/**/
!benchmarks/*.py
!benchmarks/*.md
!benchmarks/results/*.json
!benchmarks/results/*.csv
!rtl/
!rtl/*.v
!rtl/
!rtl/**/
!rtl/**/*.v
!rtl/*.sv
!rtl/**/*.sv
!rtl/**/*.f
!rtl/**/*.md
!tools/
!tools/*.ps1
!tools/*.json

# Generated Python/simulator state remains ignored even under the exceptions.
src/**/__pycache__/
*.py[cod]
*.fst
*.dat
reports/
Cache/
Cache_modular/
picker_out/

# Keep the final report source and its reproducible build script in Git while
# ignoring generated simulation/formal/coverage artifacts under reports/.
!reports/
reports/*
!reports/final/
reports/final/*
!reports/final/*.md
!reports/final/*.py
!reports/final/*.pdf
!reports/final/verification_run_manifest.json
!reports/final/rtl_coverage_dataset_manifest.json
!reports/final/rtl_release_point_matrix.csv.gz
!reports/final/rtl_release_gate.json.gz
!reports/final/rtl_coverage_raw/
reports/final/rtl_coverage_raw/*
!reports/final/rtl_coverage_raw/README.md
!reports/final/rtl_coverage_raw/*.dat.gz
!reports/final/rtl_coverage_raw/*.info.gz
!reports/full_system/
!reports/full_system/replay_closure/
!reports/full_system/replay_closure/controlled_checker_failure.json
!reports/closure/
reports/closure/*
!reports/closure/rtl_release_regression_status.json
!reports/closure/rtl_release_gate_status.json
!reports/closure/rtl_release_gate.log.gz
!reports/closure/release_runs/
reports/closure/release_runs/*
!reports/closure/release_runs/*.log.gz
